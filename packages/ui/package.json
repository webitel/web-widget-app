{
	"name": "@webitel/web-widget-ui",
	"version": "0.0.1",
	"description": "Webitel web widget UI: ready chat window built on @webitel/web-widget-core",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/webitel/web-widget-app.git",
		"directory": "packages/ui"
	},
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"unpkg": "./dist/script/webitel-widget.js",
	"jsdelivr": "./dist/script/webitel-widget.js",
	"files": [
		"dist",
		"!dist/**/.vite"
	],
	"scripts": {
		"build": "vite build && vite build --mode script && tsc -p tsconfig.build.json && npm run size",
		"typecheck": "tsc -p tsconfig.json",
		"lint:package": "publint",
		"size": "node build/check-size.ts"
	},
	"peerDependencies": {
		"@webitel/web-widget-core": "0.0.1"
	},
	"devDependencies": {
		"@vitejs/plugin-vue": "^6.0.11",
		"@webitel/ui-sdk": "~26.12",
		"@webitel/web-widget-core": "0.0.1",
		"clipboard-copy": "^4.0.1",
		"vue": "^3.5.46",
		"vue-i18n": "^11.4.23"
	},
	"keywords": [
		"webitel",
		"chat",
		"widget",
		"web-component"
	],
	"author": "webitel",
	"publishConfig": {
		"access": "public"
	}
}
